class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	    int[] arr ={6,7,8,9,1,2,3,4,5}; //rotated distinct sorted array
	    int target = 8;
		System.out.println(findIndex(arr, target));
	}
	
	public static int findIndex(int[] arr, int target) {
	    int l=0, h=arr.length-1;
	    
	    while(l<=h) {
	        int mid = l+(h-l)/2;
	        if(arr[mid]==target) {
	            return mid;
	        }
	        if(arr[mid]>=arr[l]) {
	            if(target>=arr[l] && arr[mid]>target) {
	                h= mid-1;
	            }
	            else {
	                l=mid+1;
	            }
	        }
	        else {
	            if(target>arr[mid] && target<=arr[h]) {
	                l=mid+1;
	            }
	            else {
	                h=mid-1;
	            }
	        }
	        
	    }
	    return -1;
	}
}

// Searches for a target in a rotated sorted array.
// Approach: Modified Binary Search
// Identify the sorted half and check whether the target lies within it.
// Eliminate half of the search space in each iteration.
// Returns -1 if the target is not found.
// Assumption: Array contains distinct elements.
// Time Complexity: O(log n)
// Space Complexity: O(1)
