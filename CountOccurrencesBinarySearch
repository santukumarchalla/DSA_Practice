class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int[] arr = {1,2,3,3,3,3,3,3,3,3,4,5};
		int target = 3;
		System.out.println((meth(arr, target)));
	}
	
	public static int meth(int[] arr, int target) {
	    
	    int first = first(arr, target);
	    if(first==-1) {
	        return 0;
	    }
	    int last = last(arr, target);
	    
	   return last-first+1;
	}
	
	public static int first(int[] arr, int target) {
	     int l=0, h= arr.length-1;
	    int answer = -1;
	    
	    while(l<=h) {
	        int m = l+(h-l)/2;
	        if(arr[m]==target) {
	            answer = m;
	            h = m-1;
	        }
	        else if(arr[m]<target) {
	            l= m+1;
	        }
	        else {
	            h= m-1;
	        }
	    }
	    return answer;
	}
	
		public static int last(int[] arr, int target) {
	     int l=0, h= arr.length-1;
	    int answer = -1;
	    
	    while(l<=h) {
	        int m = l+(h-l)/2;
	        if(arr[m]==target) {
	            answer = m;
	            l = m+1;
	        }
	        else if(arr[m]<target) {
	            l= m+1;
	        }
	        else {
	            h= m-1;
	        }
	    }
	    return answer;
	}
}


// Counts the occurrences of a target element in a sorted array.
// Approach: Binary Search (First and Last Occurrence)
// Count = Last Occurrence - First Occurrence + 1.
// Returns 0 if the target is not found.
// Time Complexity: O(log n)
// Space Complexity: O(1)
