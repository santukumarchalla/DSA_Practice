class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int[] arr = {1,2,3,3,3,3,3,3,3,3,4,5};
		int target = 3;
		System.out.println(Arrays.toString(meth(arr, target)));
	}
	
	public static int[] meth(int[] arr, int target) {
	   return new int[]{first(arr, target), last(arr, target)};
	}
	
	public static int first(int[] arr, int target) {
	     int l=0, h= arr.length-1;
	    int answer = -1;
	    
	    while(l<=h) {
	        int m = l+(h-l)/2;
	        if(arr[m]==target) {
	            answer = m;
	            h = m-1;
	        }
	        else if(arr[m]<target) {
	            l= m+1;
	        }
	        else {
	            h= m-1;
	        }
	    }
	    return answer;
	}
	
		public static int last(int[] arr, int target) {
	     int l=0, h= arr.length-1;
	    int answer = -1;
	    
	    while(l<=h) {
	        int m = l+(h-l)/2;
	        if(arr[m]==target) {
	            answer = m;
	            l = m+1;
	        }
	        else if(arr[m]<target) {
	            l= m+1;
	        }
	        else {
	            h= m-1;
	        }
	    }
	    return answer;
	}
}

// Finds the first and last occurrence of a target in a sorted array.
// Approach: Binary Search
// Continues searching after finding the target to locate the boundary.
// Returns {-1, -1} if the target is not found.
// Time Complexity: O(log n)
// Space Complexity: O(1)
