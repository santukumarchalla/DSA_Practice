class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int[] arr = {1,2,3,3,3,3,3,3,3,3,4,5};
		int target = 3;
		System.out.println(Arrays.toString(meth(arr, target)));
	}
	
	public static int[] meth(int[] arr, int target) {
	    int first = -1, last = -1;
	    for(int i=0; i<arr.length; i++) {
	        if(arr[i]==target) {
	            if(first==-1) {
	                first = i;
	            }
	            last =i;
	        }
	    }
	    return new int[]{first, last};
	}
}

// Finds the first and last occurrence of a target element in an array.
// Approach: Brute Force (Linear Search)
// Returns {-1, -1} if the target is not found.
// Time Complexity: O(n)
// Space Complexity: O(1)
