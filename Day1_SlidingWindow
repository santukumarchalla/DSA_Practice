class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		int[] a = {2,1,5,1,3,2};
		int k=3;
		System.out.println(Codechef.meth(a,k));
	}
	
	public static int meth(int a[], int k) {
	    int sum =0;
	    for(int i=0; i<a.length-k+1; i++) {
	        int result =0;
	        for(int j=i; j<i+k; j++) {
	            result = result + a[j];
	        }
	        sum = Math.max(sum,result);
	    }
	    return sum;
	}
}

// Finds the maximum sum of a contiguous subarray of size k.
// Approach: Brute Force / Fixed-Size Window
// Time Complexity: O(n * k)
// Space Complexity: O(1)
